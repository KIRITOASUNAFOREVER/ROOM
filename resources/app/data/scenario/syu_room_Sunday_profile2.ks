[mask  time="1000"  effect="rollIn"  color="0x000000"  ]
[cm  ]
[chara_hide_all  time="0"  wait="true"  ]
[tb_image_hide  time="0"  ]
[bg  time="0"  method="crossfade"  storage="comp.jpg"  ]
[tb_cg  id="cg9"  ]
[mask_off  time="1000"  effect="fadeOut"  ]
[tb_show_message_window  ]
[playse  volume="100"  time="1000"  buf="0"  storage="sistem.mp3"  ]
[tb_start_text mode=1 ]
[font color="yellow"]Profile complete!![p]
The complete illustrations have been unlocked.[resetfont][p]
[_tb_end_text]

[tb_hide_message_window  ]
