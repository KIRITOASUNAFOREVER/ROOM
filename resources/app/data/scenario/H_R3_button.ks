[elsif exp="f.H_zettyou_purasu== 3 "]
[call target="*zettyoupurasu"]

[elsif exp="f.H_zettyou_mainasu== 3 "]
[call target="*zettyoumainasu"]

[endif]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
;熟練度別にグラをコール
;kunni

[if exp="f.H_R3_jyukuren == -1 "]
