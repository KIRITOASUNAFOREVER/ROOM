[chara_show  name="chara_konno"  time="1000"  wait="false"  storage="chara/122/adv_konno_def.gif"  width="435"  height="993"  left="223"  top="-12"  reflect="false"  ]
[chara_show  name="chara_yume"  time="1000"  wait="true"  storage="chara/121/adv_yume_kanasii.gif"  width="1011"  height="1011"  left="371"  top="2"  reflect="false"  ]
[playbgm  volume="100"  time="1000"  loop="true"  storage="nitijyou2.mp3"  ]
[tb_start_text mode=1 ]
Yume "Sorry to call you over so sudden..."[p]
Konno "No, it's fine! What happened? You look exhausted..."[p]
Yume "Truth is, my room feels strange... After I leave in the morning and come back, it feels like things have been moved around."[p]
[chara_mod name="chara_konno" cross="false" time="500" storage="chara/122/adv_konno_okoru.gif"]Konno "Eh?! You mean like a robbery?!"[p]
Yume "Nothing's gotten stolen. Everything's still here... I think."[p]
Yume "How do I put it? Something feels off... Like everything around the place has been moved around a little bit."[p]
Yume "Sorry if I'm not making any sense."[p]
Konno "You'd be surprised how accurate that feeling can be. You'll want to be more careful."[p]
Konno "Oh I know! You wanna come to my place? Maybe stay there a little while."[p]
Yume "No, I shouldn't bother you when you're studying. But I might have to count on you later on."[p]
Konno "All right... But if even the slightest little thing seems off, call me. Okay?"[p]
[chara_mod name="chara_yume" cross="false" time="500" storage="chara/121/adv_yume_egao.gif"]Yume "Rei...! I will, thanks."[p]
[_tb_end_text]

